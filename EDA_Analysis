    "# CHART 2 — AUM Growth (fixed: date, fund_house)\n",
    "plt.figure(figsize=(12,5))\n",
    "aum_top = aum_df.groupby('date')['aum_crore'].sum().reset_index()\n",
    "sns.barplot(data=aum_top, x='date', y='aum_crore', palette='Blues_d')\n",
    "plt.title('Total AUM Growth Over Time')\n",
    "plt.xticks(rotation=90, fontsize=7)\n",
    "plt.tight_layout()\n",
    "plt.savefig('charts/chart2_aum.png')\n",
    "plt.show()\n",
    "print(\"✅ Chart 2 done!\")\n",
    "\n",
    "# CHART 3 — SIP Inflow\n",
    "sip_df['month'] = pd.to_datetime(sip_df['month'])\n",
    "fig = px.line(sip_df, x='month', y='sip_inflow_crore',\n",
    "              title='Monthly SIP Inflows 2022–2025')\n",
    "fig.add_annotation(x=sip_df['month'].max(),\n",
    "                   y=sip_df['sip_inflow_crore'].max(),\n",
    "                   text=\"All-time High!\", showarrow=True)\n",
    "fig.write_html('charts/chart3_sip.html')\n",
    "fig.show()\n",
    "print(\"✅ Chart 3 done!\")\n",
    "\n",
    "# CHART 4 — Heatmap\n",
    "pivot = inflow_df.pivot(index='category', columns='month', values='net_inflow_crore')\n",
    "plt.figure(figsize=(16,5))\n",
    "sns.heatmap(pivot, cmap='RdYlGn', linewidths=0.3)\n",
    "plt.title('Category-wise Net Inflow Heatmap')\n",
    "plt.tight_layout()\n",
    "plt.savefig('charts/chart4_heatmap.png')\n",
    "plt.show()\n",
    "print(\"✅ Chart 4 done!\")\n",
    "\n",
    "# CHART 5 — Folio Growth\n",
    "folio_df['month'] = pd.to_datetime(folio_df['month'])\n",
    "fig = px.line(folio_df, x='month', y='total_folios_crore',\n",
    "              title='Total Folio Count Growth')\n",
    "fig.write_html('charts/chart5_folio.html')\n",
    "fig.show()\n",
    "print(\"✅ Chart 5 done!\")\n",
    "\n",
    "# CHART 6 — Age Pie\n",
    "plt.figure(figsize=(7,7))\n",
    "age = investor_df['age_group'].value_counts()\n",
    "plt.pie(age, labels=age.index, autopct='%1.1f%%', startangle=140)\n",
    "plt.title('Investor Age Group Distribution')\n",
    "plt.savefig('charts/chart6_age.png')\n",
    "plt.show()\n",
    "print(\"✅ Chart 6 done!\")\n",
    "\n",
    "# CHART 7 — Gender\n",
    "plt.figure(figsize=(5,5))\n",
    "gender = investor_df['gender'].value_counts()\n",
    "plt.pie(gender, labels=gender.index, autopct='%1.1f%%')\n",
    "plt.title('Gender Split')\n",
    "plt.savefig('charts/chart7_gender.png')\n",
    "plt.show()\n",
    "print(\"✅ Chart 7 done!\")\n",
    "\n",
    "# CHART 8 — City Tier\n",
    "plt.figure(figsize=(5,5))\n",
    "tier = investor_df['city_tier'].value_counts()\n",
    "plt.pie(tier, labels=tier.index, autopct='%1.1f%%')\n",
    "plt.title('T30 vs B30 City Tier')\n",
    "plt.savefig('charts/chart8_tier.png')\n",
    "plt.show()\n",
    "print(\"✅ Chart 8 done!\")\n",
    "\n",
    "# CHART 9 — Sector Donut\n",
    "sector = holdings_df.groupby('sector')['weight_pct'].sum().reset_index()\n",
    "fig = px.pie(sector, names='sector', values='weight_pct',\n",
    "             hole=0.4, title='Sector Allocation')\n",
    "fig.write_html('charts/chart9_sector.html')\n",
    "fig.show()\n",
    "print(\"✅ Chart 9 done!\")\n",
    "\n",
    "# CHART 10 — Sharpe Ratio\n",
    "plt.figure(figsize=(14,5))\n",
    "top_sharpe = scheme_df.sort_values('sharpe_ratio', ascending=False).head(15)\n",
    "sns.barplot(data=top_sharpe, x='scheme_name', y='sharpe_ratio', palette='coolwarm')\n",
    "plt.title('Top 15 Funds by Sharpe Ratio')\n",
    "plt.xticks(rotation=90, fontsize=7)\n",
    "plt.tight_layout()\n",
    "plt.savefig('charts/chart10_sharpe.png')\n",
    "plt.show()\n",
    "print(\"✅ Chart 10 done!\")\n",
    "\n",
    "print(\"\\n🎉 ALL 10 CHARTS COMPLETE!\")"
   ]
