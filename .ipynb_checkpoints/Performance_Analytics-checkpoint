    "score_df['expense_rank'] = score_df['expense_ratio_pct'].rank(ascending=True)\n",
    "score_df['dd_rank']      = score_df['max_drawdown_pct'].rank(ascending=False)\n",
    "\n",
    "# Normalize ranks to 0-100 (higher = better)\n",
    "n = len(score_df)\n",
    "for col in ['r3yr_rank','sharpe_rank','alpha_rank','expense_rank','dd_rank']:\n",
    "    score_df[col] = (n - score_df[col]) / (n - 1) * 100\n",
