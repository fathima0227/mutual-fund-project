    "# Since NAV history is empty, simulate daily returns from std_dev\n",
    "# This is statistically valid — we know annual std dev for each fund\n",
    "np.random.seed(42)\n",
    "TRADING_DAYS = 252\n",
    "\n",
    "# Simulate daily returns for each fund\n",
    "daily_returns_dict = {}\n",
    "for _, row in scheme_df.iterrows():\n",
    "    ann_return = row['return_3yr_pct'] / 100\n",
