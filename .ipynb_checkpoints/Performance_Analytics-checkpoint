    "    daily_std  = ann_std / np.sqrt(TRADING_DAYS)\n",
    "    daily_returns_dict[row['scheme_name']] = np.random.normal(\n",
    "        daily_mean, daily_std, TRADING_DAYS * 3\n",
    "    )\n",
