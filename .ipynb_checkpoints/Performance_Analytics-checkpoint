    "# ============================================================\n",
    "# Part 6: Fund Scorecard (0-100)\n",
    "# ============================================================\n",
    "\n",
    "score_df = scheme_df[['amfi_code','scheme_name','fund_house',\n",
    "                       'category','return_3yr_pct','sharpe_ratio',\n",
    "                       'alpha','expense_ratio_pct','max_drawdown_pct']].copy()\n",
